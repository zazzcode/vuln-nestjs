{
  "name": "@zazzles/exchange-gateway",
  "version": "0.0.0",
  "description": "The federated graph and the REST edge of Zazzles Exchange: the only listener a client uses",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
