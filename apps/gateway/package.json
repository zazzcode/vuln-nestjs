    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.config.int.ts"
  },
  "dependencies": {
    "@apollo/gateway": "2.14.5",
    "@apollo/server": "5.5.2",
    "@apollo/subgraph": "2.17.0",
    "@as-integrations/fastify": "3.1.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/formbody": "9.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/static": "10.1.12",
    "@nestjs/apollo": "14.2.2",
    "@nestjs/common": "12.6.3",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.3",
    "@nestjs/graphql": "14.2.2",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-fastify": "12.6.3",
    "@nestjs/swagger": "12.1.3",
