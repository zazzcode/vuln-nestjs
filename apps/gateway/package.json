  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.17",
    "@nestjs/testing": "12.6.3",
    "@types/node": "24.19.4",
    "@types/supertest": "7.2.1",
    "@zazzles/exchange-testing": "workspace:*",
    "fastify": "5.12.8",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vite": "8.4.0",
