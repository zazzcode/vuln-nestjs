                  "pm.test('served as a page', () => pm.expect(pm.response.headers.get('content-type')).to.include('text/html'));",
                  "const marker = \"<img src=x onerror=\\\"window.__zazzles='zazzles-lab-marker'\\\">\";",
                  "pm.test('gained: the name is the page markup, unescaped, with no policy above it', () => {",
