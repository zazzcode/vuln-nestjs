                  "  pm.expect(pm.response.text()).to.not.include('&lt;img');",
                  "  pm.expect(pm.response.headers.get('content-security-policy')).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/public/status?name=%3Cimg%20src%3Dx%20onerror%3D%22window.__zazzles%3D'zazzles-lab-marker'%22%3E"
          },
