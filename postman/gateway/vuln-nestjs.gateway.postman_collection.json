{
  "info": {
    "_postman_id": "9aa85967-f614-4956-b8d0-25dfbb367ec7",
    "name": "VCX: the gateway",
    "description": "The gateway, on the one address a client uses. Every other collection calls one microservice on its own.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "The lab",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('reports the gateway and its three services as up', () => {",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(Object.keys(body.services).sort()).to.eql(['accounts', 'notifications', 'trading']);",
                  "  for (const service of Object.keys(body.services)) {",
                  "    pm.expect(body.services[service].status, service).to.eql('ok');",
                  "    pm.expect(body.services[service].store.connected, service).to.be.true;",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/health"
          },
          "response": []
        },
        {
          "name": "Reset",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns every store to the fake data', () =>",
                  "  pm.expect(body).to.eql({ accounts: 'ok', trading: 'ok', notifications: 'ok' }));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/lab/reset"
          },
          "response": []
        }
      ]
    },
    {
      "name": "The graph",
      "item": [
        {
          "name": "A query answered from three services",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('carries no error', () => pm.expect(body.errors).to.be.undefined);",
                  "pm.test(\"joins trading's order to accounts' user, and adds notifications' announcement\", () =>",
                  "  pm.expect(body.data).to.eql({",
                  "    orders: [",
                  "      { id: '1', symbol: 'BTC-USD', user: { id: 'u-alice', email: 'alice@vcx.exchange' } },",
                  "      { id: '6', symbol: 'SOL-USD', user: { id: 'u-alice', email: 'alice@vcx.exchange' } },",
                  "    ],",
                  "    announcements: [{ id: '1', title: 'Welcome to VCX' }],",
                  "  }));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ orders { id symbol user { id email } } announcements { id title } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "A query without a caller",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('orders is refused, with its code', () => {",
                  "  pm.expect(body.errors[0].path).to.eql(['orders']);",
                  "  pm.expect(body.errors[0].extensions.code).to.eql('UNAUTHENTICATED');",
                  "});",
                  "pm.test('and with no orders', () => pm.expect(body.data).to.eql(null));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ orders { id } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "GQL",
      "item": [
        {
          "name": "GQL-001 introspection answers the whole graph to anyone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('carries no error', () => pm.expect(body.errors).to.be.undefined);",
                  "const names = body.data.__schema.types.map((t) => t.name);",
                  "pm.test('gained: every type of all three services, with no credential', () => {",
                  "  pm.expect(names).to.include.members(['User', 'Order', 'Market', 'Announcement']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ __schema { types { name } } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "GQL-001 the GraphiQL IDE is served to a browser",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "pm.test('served as HTML', () => pm.expect(pm.response.headers.get('content-type')).to.include('text/html'));",
                  "pm.test('gained: the IDE itself', () => pm.expect(pm.response.text()).to.include('<title>GraphiQL</title>'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "accept",
                "value": "text/html",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/graphql"
          },
          "response": []
        },
        {
          "name": "GQL-002 a query nested far past any limit is answered with data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('carries no error', () => pm.expect(body.errors).to.be.undefined);",
                  "let level = body.data.me;",
                  "for (let walked = 0; walked < 12; walked++) {",
                  "  level = level.orders[0].user;",
                  "}",
                  "pm.test('gained: data twelve levels deep, no limit stood in the way', () => {",
                  "  pm.expect(level.id).to.eql('u-alice');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query { me { displayName orders { id user { id orders { id user { id orders { id user { id orders { id user { id orders { id user { id orders { id user { id orders { id user { id orders { id user { id orders { id user { id orders { id user { id orders { id user { id orders { id user { id }}}}}}}}}}}}}}}}}}}}}}}} } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "GQL-003 one request carries an array of operations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const bodies = pm.response.json();",
                  "pm.test('gained: an array of answers, one per operation', () => {",
                  "  pm.expect(Array.isArray(bodies)).to.be.true;",
                  "  pm.expect(bodies).to.have.lengthOf(3);",
                  "  for (const body of bodies) pm.expect(body.data.__typename).to.eql('Query');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "[\n  {\"query\": \"{ __typename }\"},\n  {\"query\": \"{ __typename }\"},\n  {\"query\": \"{ __typename }\"}\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "GQL-004 an error answers the server stack",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 400 for the invalid field', () => pm.response.to.have.status(400));",
                  "const error = pm.response.json().errors[0];",
                  "pm.test('gained: the server stack in extensions.stacktrace', () => {",
                  "  pm.expect(Array.isArray(error.extensions.stacktrace)).to.be.true;",
                  "  pm.expect(error.extensions.stacktrace.length).to.be.above(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"{ me { nope } }\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "GQL-007 a direct _entities call reads any user by key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('gained: the administrator record by key, with no credential', () => {",
                  "  pm.expect(body.data._entities[0]).to.eql({ id: 'u-admin', email: 'admin@vcx.exchange' });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{accountsUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($r: [_Any!]!) { _entities(representations: $r) { ... on User { id email } } }\",\n  \"variables\": {\n    \"r\": [\n      {\n        \"__typename\": \"User\",\n        \"id\": \"u-admin\"\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "CONFIG",
      "item": [
        {
          "name": "CONFIG-001 the public ticker echoes any origin, with credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "pm.test('gained: the unlisted origin is echoed, credentials allowed', () => {",
                  "  pm.expect(pm.response.headers.get('access-control-allow-origin')).to.eql('http://127.0.0.1:4020');",
                  "  pm.expect(pm.response.headers.get('access-control-allow-credentials')).to.eql('true');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "origin",
                "value": "http://127.0.0.1:4020",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/public/ticker"
          },
          "response": []
        },
        {
          "name": "CONFIG-001 the markets ticker answers no CORS header at all",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "pm.test('counterpart: the same Origin meets no CORS header at all', () => {",
                  "  pm.expect(pm.response.headers.get('access-control-allow-origin')).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "origin",
                "value": "http://127.0.0.1:4020",
                "type": "text"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/markets/ticker"
          },
          "response": []
        },
        {
          "name": "CONFIG-002 the public status page carries no security headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "pm.test('gained: no CSP, no nosniff, no frame options', () => {",
                  "  pm.expect(pm.response.headers.get('content-security-policy')).to.be.undefined;",
                  "  pm.expect(pm.response.headers.get('x-content-type-options')).to.be.undefined;",
                  "  pm.expect(pm.response.headers.get('x-frame-options')).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/public/status"
          },
          "response": []
        },
        {
          "name": "CONFIG-002 the default status page sets the security headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "pm.test('counterpart: content-security-policy and nosniff are set by hand', () => {",
                  "  pm.expect(pm.response.headers.get('content-security-policy')).to.eql(\"default-src 'self'\");",
                  "  pm.expect(pm.response.headers.get('x-content-type-options')).to.eql('nosniff');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/status"
          },
          "response": []
        },
        {
          "name": "CONFIG-003 the API document is served with no authentication",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const paths = Object.keys(pm.response.json().paths);",
                  "pm.test('gained: the whole API surface, with no token', () => {",
                  "  pm.expect(paths).to.include('/api/v1/health');",
                  "  pm.expect(paths).to.include('/api/v1/auth/sign-in');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/docs/json"
          },
          "response": []
        },
        {
          "name": "CONFIG-003 the guarded copy of the API document answers 401 without a token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('counterpart: the same caller is refused with 401', () => {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/admin/openapi.json"
          },
          "response": []
        },
        {
          "name": "CONFIG-004 the debug page answers the environment and the versions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('gained: the environment of the process, secret values included', () => {",
                  "  pm.expect(body.environment.JWT_SECRET).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(body.dependencies['@apollo/gateway']).to.match(/^\\d+/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/debug"
          },
          "response": []
        },
        {
          "name": "CONFIG-004 health answers a status and nothing else",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "pm.test('counterpart: no versions, no environment', () => {",
                  "  pm.expect(pm.response.json().versions).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/v1/health"
          },
          "response": []
        }
      ]
    }
  ]
}
