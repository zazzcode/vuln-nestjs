        {
          "name": "SQL-004 tradesSorted: the order of the answer says a balance it never read",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('carries no error', () => pm.expect(body.errors).to.be.undefined);",
                  "pm.test('ascending ids came back reversed, which happens only above 400.00', () =>",
                  "  pm.expect(body.data.tradesSorted.map((t) => t.id)).to.eql(['3', '2', '1']));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{tradingUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($symbol: String!, $sortBy: String!, $sortDir: String!) { tradesSorted(symbol: $symbol, sortBy: $sortBy, sortDir: $sortDir) { id } }\",\n  \"variables\": {\n    \"symbol\": \"BTC-USD\",\n    \"sortBy\": \"id * (SELECT CASE WHEN w.balance > 40000 THEN -1 ELSE 1 END FROM wallets w WHERE w.userId = 'u-erin' AND w.asset = 'USD')\",\n    \"sortDir\": \"ASC\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
