            ],
            "url": "{{tradingUrl}}/graphql",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query($input: TradeHistoryInput!) { tradeHistory(input: $input) { id symbol } }\",\n  \"variables\": {\n    \"input\": {\n      \"symbol\": \"BTC-USD' OR '1'='1\",\n      \"side\": \"BUY\"\n    }\n  }\n}",
              "options": {
