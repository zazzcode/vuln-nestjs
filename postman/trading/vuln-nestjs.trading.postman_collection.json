        {
          "name": "SQL-002 tradeHistory returns trades of symbols it never named",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('carries no error', () => pm.expect(body.errors).to.be.undefined);",
                  "pm.test('eleven rows came back for a symbol that matches no market', () =>",
                  "  pm.expect(body.data.tradeHistory).to.have.lengthOf(11));",
                  "pm.test('among them symbols the payload never named', () =>",
                  "  pm.expect(body.data.tradeHistory.map((t) => t.symbol)).to.include('ETH-USD'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
