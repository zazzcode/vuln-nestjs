{
  "name": "@zazzles/exchange-testing",
  "version": "0.0.0",
  "description": "Start and stop one service or the whole lab from a test, and call its graph",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "12.6.3",
    "@nestjs/core": "12.6.3",
    "@nestjs/jwt": "12.0.5",
    "@zazzles/exchange-config": "workspace:*",
    "@zazzles/exchange-internal-auth": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "typescript": "6.0.3",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
